{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "marketing-images": "node scripts/generate-marketing-webp.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prerender": "node scripts/prerender-public-routes.mjs",
    "build:seo": "npm run build && npm run prerender",
    "prebuild": "node scripts/generate-pwa-icons.mjs && node scripts/generate-marketing-webp.mjs && node scripts/generate-sitemap.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:install-browsers": "playwright install chromium",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:mobile": "playwright test e2e/mobile-public.spec.ts",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/react": "^10.70.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  }
}
